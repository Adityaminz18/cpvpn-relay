# Copy to .env (git-ignored) and edit. tunnel.py reads ./.env automatically.
# Command-line flags override these values.
# Keep comments on their own lines: inline "# ..." after a value is NOT supported.

# --- VPN tunnel ---
# true  = built-in Check Point VPN client (Ubuntu)
# false = the tunnel comes from elsewhere, e.g. the official Endpoint Security VPN app (macOS)
CPVPN_VPN=true
# VPN gateway IP or hostname, and VPN username
CPVPN_GATEWAY=
CPVPN_USER=
# leave empty to be asked for it during setup
CPVPN_PASSWORD=
# office subnet behind the VPN (saved in the config for reference)
CPVPN_SUBNET=192.168.0.0/24
# ping CPVPN_TEST_IP every minute and restart the tunnel if it fails
CPVPN_WATCHDOG=true
# must answer ping: used by the setup check and the watchdog
CPVPN_TEST_IP=192.168.0.152

# --- Relay (HAProxy) ---
CPVPN_PROXY=true
# address:port HAProxy listens on (0.0.0.0 = all networks)
CPVPN_PROXY_LISTEN=0.0.0.0:9999
# target server ip:port behind the VPN (required with CPVPN_PROXY=true)
CPVPN_PROXY_BACKEND=192.168.0.152:90
# optional: only allow this IP or subnet, e.g. 192.168.1.0/24
CPVPN_PROXY_SOURCE=
